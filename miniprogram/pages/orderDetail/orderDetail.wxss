/* pages/orderDetail/orderDetail.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 状态卡片 */
.status-card {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.status-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
}

.status-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 通用section */
.section {
  background: #fff;
  margin: 16rpx 0;
  padding: 28rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2563eb;
}

/* 商品项 */
.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.goods-item:last-of-type {
  border-bottom: none;
}

.gi-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.gi-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.gi-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.4;
}

.gi-variant {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
}

.gi-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gi-price {
  font-size: 28rpx;
  color: #dc2626;
  font-weight: 600;
}

.gi-qty {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 商品合计 */
.goods-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f1f5f9;
  font-size: 26rpx;
  color: #475569;
}

.gt-amount {
  display: flex;
  align-items: baseline;
}

.gt-value {
  font-size: 34rpx;
  color: #dc2626;
  font-weight: 700;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.ir-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.ir-value {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.ir-copy {
  font-size: 24rpx;
  color: #2563eb;
  padding: 4rpx 16rpx;
  border: 2rpx solid #2563eb;
  border-radius: 8rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 56rpx;
  border-radius: 44rpx;
}

.action-btn.outline {
  background: #fff;
  color: #475569;
  border: 2rpx solid #cbd5e1;
}

.action-btn.primary {
  background: #2563eb;
  color: #fff;
}

.action-btn.disabled {
  opacity: 0.6;
}

/* 联系客服按钮重置 */
.contact-btn {
  line-height: normal;
  margin: 0;
}

.contact-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #94a3b8;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
