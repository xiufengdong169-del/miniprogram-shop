<!-- pages/orderDetail/orderDetail.wxml -->
<view class="page" wx:if="{{!loading && order}}">
  <!-- 状态卡片 -->
  <view class="status-card" style="background: {{statusColor === '#16a34a' ? 'linear-gradient(135deg, #16a34a, #15803d)' : statusColor === '#f59e0b' ? 'linear-gradient(135deg, #f59e0b, #d97706)' : statusColor === '#2563eb' ? 'linear-gradient(135deg, #2563eb, #1d4ed8)' : 'linear-gradient(135deg, #64748b, #475569)'}};">
    <view class="status-icon">
      {{order.status === 0 ? '⏰' : order.status === 1 ? '✅' : order.status === 2 ? '🔄' : order.status === 3 ? '📦' : order.status === 4 ? '❌' : '💰'}}
    </view>
    <view class="status-text">{{statusText}}</view>
    <view class="status-desc" wx:if="{{order.status === 0}}">请尽快完成支付</view>
    <view class="status-desc" wx:elif="{{order.status === 1}}">我们将在1个工作日内开始服务</view>
    <view class="status-desc" wx:elif="{{order.status === 2}}">服务进行中，请耐心等待</view>
    <view class="status-desc" wx:elif="{{order.status === 3}}">服务已完成</view>
  </view>

  <!-- 商品信息 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="index">
      <image class="gi-image" src="{{item.image || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="gi-info">
        <view class="gi-name text-ellipsis-2">{{item.shortTitle || item.name}}</view>
        <view wx:if="{{item.variantName}}" class="gi-variant">{{item.variantName}}</view>
        <view class="gi-bottom">
          <text class="gi-price">¥{{item.unitPrice / 100}}</text>
          <text class="gi-qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
    <view class="goods-total">
      <text>共{{order.items.length}}件商品</text>
      <view class="gt-amount">
        <text>合计：</text>
        <text class="gt-value">{{order.totalAmount === 0 ? '免费' : '¥' + (order.totalAmount / 100)}}</text>
      </view>
    </view>
  </view>

  <!-- 联系信息 -->
  <view class="section">
    <view class="section-title">联系信息</view>
    <view class="info-row">
      <text class="ir-label">联系人</text>
      <text class="ir-value">{{order.contactInfo.name}}</text>
    </view>
    <view class="info-row">
      <text class="ir-label">手机号</text>
      <text class="ir-value">{{order.contactInfo.phone}}</text>
    </view>
    <view class="info-row" wx:if="{{order.contactInfo.company}}">
      <text class="ir-label">公司</text>
      <text class="ir-value">{{order.contactInfo.company}}</text>
    </view>
    <view class="info-row" wx:if="{{order.contactInfo.email}}">
      <text class="ir-label">邮箱</text>
      <text class="ir-value">{{order.contactInfo.email}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="ir-label">备注</text>
      <text class="ir-value">{{order.remark}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section">
    <view class="section-title">订单信息</view>
    <view class="info-row" bindtap="onCopyOrderNo">
      <text class="ir-label">订单号</text>
      <text class="ir-value">{{order.orderNo}}</text>
      <text class="ir-copy">复制</text>
    </view>
    <view class="info-row">
      <text class="ir-label">下单时间</text>
      <text class="ir-value">{{order.createTimeStr}}</text>
    </view>
    <view class="info-row" wx:if="{{order.payTimeStr}}">
      <text class="ir-label">支付时间</text>
      <text class="ir-value">{{order.payTimeStr}}</text>
    </view>
    <view class="info-row" wx:if="{{order.transactionId}}">
      <text class="ir-label">交易单号</text>
      <text class="ir-value text-ellipsis">{{order.transactionId}}</text>
    </view>
    <view class="info-row">
      <text class="ir-label">商品类型</text>
      <text class="ir-value">虚拟商品（服务类）</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view style="height: 140rpx;"></view>
  <view class="action-bar" wx:if="{{order.status === 0}}">
    <view class="action-btn outline" bindtap="onCancel">
      <text>取消订单</text>
    </view>
    <view class="action-btn primary {{paying ? 'disabled' : ''}}" bindtap="onPay">
      <text>{{paying ? '支付中...' : '立即支付'}}</text>
    </view>
  </view>

  <view class="action-bar" wx:elif="{{order.status === 1 || order.status === 2 || order.status === 3}}">
    <button class="action-btn outline contact-btn" open-type="contact" sessionFrom="orderDetail">
      <text>联系客服</text>
    </button>
  </view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading}}" class="loading-state">
  <view class="loading-spinner"></view>
  <text>加载中...</text>
</view>
