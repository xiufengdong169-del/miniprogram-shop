<!-- pages/order/order.wxml -->

<!-- ========== 下单确认模式 ========== -->
<view wx:if="{{mode === 'checkout'}}" class="page">
  <!-- 商品列表 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view class="checkout-item" wx:for="{{checkoutItems}}" wx:key="index">
      <image class="ci-image" src="{{item.image || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="ci-info">
        <view class="ci-name text-ellipsis-2">{{item.name}}</view>
        <view wx:if="{{item.variantName}}" class="ci-variant">{{item.variantName}}</view>
        <view class="ci-bottom">
          <view class="ci-price">
            <block wx:if="{{item.price === 0}}">
              <text class="free-text">免费</text>
            </block>
            <block wx:else>
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price / 100}}</text>
            </block>
          </view>
          <text class="ci-qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系人信息 -->
  <view class="section">
    <view class="section-title">联系信息</view>
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入联系人姓名" value="{{contactInfo.name}}" bindinput="onInputName" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{contactInfo.phone}}" bindinput="onInputPhone" />
    </view>
    <view class="form-item">
      <text class="form-label">公司名称</text>
      <input class="form-input" placeholder="选填，请输入公司名称" value="{{contactInfo.company}}" bindinput="onInputCompany" />
    </view>
    <view class="form-item">
      <text class="form-label">邮箱</text>
      <input class="form-input" placeholder="选填，用于接收报告和发票" value="{{contactInfo.email}}" bindinput="onInputEmail" />
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">订单备注</view>
    <textarea class="form-textarea" placeholder="选填，如有特殊需求请备注" value="{{remark}}" bindinput="onInputRemark" maxlength="200" />
  </view>

  <!-- 金额汇总 -->
  <view class="section">
    <view class="amount-row">
      <text>商品总额</text>
      <text class="amount-value">{{totalAmount === 0 ? '免费' : '¥' + (totalAmount / 100)}}</text>
    </view>
    <view class="amount-row total">
      <text>应付金额</text>
      <view class="amount-final">
        <block wx:if="{{totalAmount === 0}}">
          <text class="free-text">免费</text>
        </block>
        <block wx:else>
          <text class="price-symbol">¥</text>
          <text class="amount-final-value">{{totalAmount / 100}}</text>
        </block>
      </view>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 140rpx;"></view>

  <!-- 底部提交栏 -->
  <view class="submit-bar">
    <view class="submit-total">
      <text>合计：</text>
      <block wx:if="{{totalAmount === 0}}">
        <text class="free-text">免费</text>
      </block>
      <block wx:else>
        <text class="price-symbol">¥</text>
        <text class="submit-amount">{{totalAmount / 100}}</text>
      </block>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmitOrder">
      <text>{{submitting ? '提交中...' : (totalAmount === 0 ? '提交订单' : '提交并支付')}}</text>
    </view>
  </view>
</view>

<!-- ========== 订单列表模式 ========== -->
<view wx:elif="{{mode === 'list'}}" class="page">
  <!-- 状态Tab -->
  <view class="order-tabs">
    <view
      class="order-tab {{activeTab === item.status ? 'active' : ''}}"
      wx:for="{{orderTabs}}"
      wx:key="status"
      data-status="{{item.status}}"
      bindtap="onTabTap"
    >
      <text>{{item.text}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loadingList && orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOrderTap">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{item.status === 0 ? '#f59e0b' : item.status === 1 ? '#16a34a' : item.status === 3 ? '#64748b' : item.status === 4 ? '#94a3b8' : '#dc2626'}};">
          {{item.status === 0 ? '待支付' : item.status === 1 ? '已支付' : item.status === 2 ? '服务中' : item.status === 3 ? '已完成' : item.status === 4 ? '已取消' : '已退款'}}
        </text>
      </view>

      <view class="order-goods" wx:for="{{item.items}}" wx:for-item="good" wx:key="index">
        <image class="og-image" src="{{good.image || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="og-info">
          <view class="og-name text-ellipsis">{{good.shortTitle || good.name}}</view>
          <view wx:if="{{good.variantName}}" class="og-variant">{{good.variantName}}</view>
        </view>
        <view class="og-right">
          <text class="og-price">¥{{good.unitPrice / 100}}</text>
          <text class="og-qty">×{{good.quantity}}</text>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-total">
          <text>共{{item.items.length}}件 合计：</text>
          <text class="order-total-amount">{{item.totalAmount === 0 ? '免费' : '¥' + (item.totalAmount / 100)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loadingList}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loadingList && orders.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text>暂无订单</text>
    <view class="empty-btn" bindtap="goShopping">
      <text>去下单</text>
    </view>
  </view>
</view>
