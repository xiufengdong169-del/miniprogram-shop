/* pages/order/order.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 通用section */
.section {
  background: #fff;
  margin: 16rpx 0;
  padding: 28rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2563eb;
}

/* 下单商品列表 */
.checkout-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.checkout-item:last-child {
  border-bottom: none;
}

.ci-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.ci-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ci-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.4;
}

.ci-variant {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
}

.ci-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ci-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 600;
}

.price-value {
  font-size: 32rpx;
  color: #dc2626;
  font-weight: 700;
}

.free-text {
  font-size: 28rpx;
  color: #16a34a;
  font-weight: 700;
}

.ci-qty {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #475569;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1e293b;
  padding: 12rpx 0;
}

/* 金额汇总 */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #475569;
}

.amount-row.total {
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  margin-top: 8rpx;
}

.amount-value {
  color: #1e293b;
  font-weight: 600;
}

.amount-final {
  display: flex;
  align-items: baseline;
}

.amount-final-value {
  font-size: 40rpx;
  color: #dc2626;
  font-weight: 700;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.submit-total {
  display: flex;
  align-items: baseline;
  margin-right: 24rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.submit-amount {
  font-size: 40rpx;
  color: #dc2626;
  font-weight: 700;
}

.submit-btn {
  background: #2563eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 56rpx;
  border-radius: 44rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* ========== 订单列表 ========== */
.order-tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.order-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #64748b;
  position: relative;
}

.order-tab.active {
  color: #2563eb;
  font-weight: 600;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2563eb;
  border-radius: 2rpx;
}

/* 订单卡片 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.order-no {
  font-size: 24rpx;
  color: #94a3b8;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

/* 订单商品 */
.order-goods {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.order-goods:last-of-type {
  border-bottom: none;
}

.og-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.og-info {
  flex: 1;
  margin-left: 16rpx;
}

.og-name {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
}

.og-variant {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.og-right {
  text-align: right;
}

.og-price {
  font-size: 26rpx;
  color: #dc2626;
  font-weight: 600;
  display: block;
}

.og-qty {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.order-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.order-total {
  font-size: 24rpx;
  color: #475569;
}

.order-total-amount {
  font-size: 30rpx;
  color: #dc2626;
  font-weight: 700;
}

/* 加载/空状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-btn {
  margin-top: 40rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 64rpx;
  border-radius: 44rpx;
  font-weight: 600;
}
