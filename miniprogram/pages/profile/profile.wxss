/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 60rpx 32rpx 48rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.default-avatar {
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

/* 头像选择按钮 */
.avatar-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn .user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-edit-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-hint text {
  color: #fff;
  font-size: 20rpx;
}

.user-detail {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* 昵称输入框 */
.nick-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.3);
  padding-bottom: 4rpx;
  min-width: 300rpx;
  max-width: 400rpx;
}

.nick-placeholder {
  color: rgba(255, 255, 255, 0.5);
  font-weight: 400;
  font-size: 28rpx;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  line-height: 1.5;
  margin: 0;
}

.login-btn::after {
  border: none;
}

/* 订单状态区域 */
.order-section {
  background: #fff;
  margin: 16rpx 0;
  padding: 28rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.section-more {
  font-size: 24rpx;
  color: #94a3b8;
}

.order-status-grid {
  display: flex;
  justify-content: space-around;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon-wrap {
  position: relative;
}

.status-icon {
  font-size: 48rpx;
}

.status-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}

.status-label {
  font-size: 24rpx;
  color: #475569;
  margin-top: 12rpx;
}

/* 功能菜单 */
.menu-section {
  background: #fff;
  margin: 16rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

/* 联系客服按钮：透明覆盖在 view 菜单项上，规避 button 默认居中 */
.menu-contact {
  position: relative;
}

.contact-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 10;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
}

.contact-hit::after {
  border: none;
}

/* 底部信息 */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.footer-version {
  font-size: 20rpx;
  color: #cbd5e1;
  margin-top: 8rpx;
}
