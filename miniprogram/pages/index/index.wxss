/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* Banner */
.banner-wrap {
  width: 100%;
  overflow: hidden;
}

.banner {
  width: 100%;
  display: block;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: #64748b;
  border-radius: 32rpx;
  transition: all 0.2s;
}

.category-item.active {
  background: #2563eb;
  color: #fff;
  font-weight: 600;
}

/* 商品列表 */
.product-list {
  padding: 20rpx 24rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
