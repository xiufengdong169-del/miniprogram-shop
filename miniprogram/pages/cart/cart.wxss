/* pages/cart/cart.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 购物车列表 */
.cart-list {
  padding: 20rpx 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

/* 选中框 */
.check-box {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #cbd5e1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  transition: all 0.2s;
  background: #fff;
}

.check-box.checked {
  background: #2563eb;
  border-color: #2563eb;
}

.check-icon {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

/* 商品图 */
.image-wrap {
  position: relative;
  flex-shrink: 0;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 商品信息 */
.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
}

.item-variant {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-top: 8rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.item-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 600;
}

.price-value {
  font-size: 34rpx;
  color: #dc2626;
  font-weight: 700;
}

.free-text {
  font-size: 30rpx;
  color: #16a34a;
  font-weight: 700;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #475569;
}

.qty-num {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.cart-item.selected {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.12);
}

/* 已选中标签 */
.selected-tag {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  background: #2563eb;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.3);
}
.item-delete {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 4rpx 8rpx;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.check-all {
  display: flex;
  align-items: center;
}

.check-all-text {
  font-size: 28rpx;
  color: #475569;
  margin-left: 12rpx;
}

.total-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 20rpx;
}

.selected-summary {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 4rpx;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #1e293b;
}

.total-amount {
  font-size: 40rpx;
  color: #dc2626;
  font-weight: 700;
}

.checkout-btn {
  background: #2563eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 56rpx;
  border-radius: 44rpx;
}

.checkout-btn.disabled {
  background: #cbd5e1;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #94a3b8;
  margin-top: 24rpx;
}

.empty-btn {
  margin-top: 40rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 64rpx;
  border-radius: 44rpx;
  font-weight: 600;
}
