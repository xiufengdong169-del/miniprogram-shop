/* pages/detail/detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 主图 */
.product-hero {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #fff;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-tags {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  display: flex;
  gap: 12rpx;
}

.hero-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(37, 99, 235, 0.9);
  color: #fff;
}

/* 价格区域 */
.price-section {
  background: #fff;
  padding: 32rpx 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #dc2626;
  font-weight: 600;
}

.big-price {
  font-size: 56rpx;
  color: #dc2626;
  font-weight: 700;
  line-height: 1;
}

.big-price.free {
  color: #16a34a;
}

.original-price {
  font-size: 26rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.product-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-top: 16rpx;
  line-height: 1.4;
}

.product-subtitle {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 通用section */
.section {
  background: #fff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2563eb;
}

.section-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
}

.section-content.faq {
  white-space: pre-wrap;
}

/* 合规提示 */
.section.notice {
  background: #fffbeb;
}

.notice-text {
  color: #92400e;
  font-size: 26rpx;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
}

.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

/* 规格列表 */
.variant-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.variant-item {
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.2s;
}

.variant-item.active {
  border-color: #2563eb;
  background: #eff6ff;
}

.variant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.variant-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #dc2626;
  margin-top: 8rpx;
}

.variant-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bar-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  position: relative;
}

.icon-badge-wrap {
  position: relative;
}

.bar-icon-text {
  font-size: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #dc2626;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}

.bar-icon-label {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.cart-btn {
  background: #ff9500;
  color: #fff;
}

.cart-btn:active {
  background: #e68500;
  transform: scale(0.97);
  transition: all 0.1s;
}

.buy-btn {
  background: #2563eb;
  color: #fff;
}

.buy-btn:active {
  background: #1d4ed8;
  transform: scale(0.97);
  transition: all 0.1s;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.97);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #94a3b8;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 规格弹窗 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.popup-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.popup-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.popup-variants {
  margin-bottom: 32rpx;
}

.popup-variant {
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.popup-variant.active {
  border-color: #2563eb;
  background: #eff6ff;
}

.pv-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.pv-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.pv-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #dc2626;
  margin-top: 8rpx;
}

.popup-btn {
  height: 88rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}
