/* components/product-card/product-card.wxss */
.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-hover {
  opacity: 0.9;
  transform: scale(0.98);
  transition: all 0.1s;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.product-badge.free {
  background: #dcfce7;
  color: #16a34a;
}

.product-badge.hot {
  background: #fee2e2;
  color: #dc2626;
}

.product-info {
  padding: 20rpx 24rpx 24rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
  min-height: 84rpx;
}

.product-subtitle {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 8rpx;
}

.product-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #dbeafe;
  color: #2563eb;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #dc2626;
  font-weight: 600;
}

.price-value {
  font-size: 40rpx;
  color: #dc2626;
  font-weight: 700;
}

.free-text {
  font-size: 36rpx;
  color: #16a34a;
  font-weight: 700;
}

.price-original {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-action {
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  active-background: #1d4ed8;
}

.product-action:active {
  background: #1d4ed8;
  transform: scale(0.95);
  transition: all 0.1s;
}

.action-text {
  white-space: nowrap;
}
